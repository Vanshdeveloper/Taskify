<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- SmoothUI OLED Canvas (#09090B to #141417) -->
    <gradient
        android:startColor="#FA18181B"
        android:centerColor="#FA111113"
        android:endColor="#FA09090B"
        android:angle="315"
        android:type="linear" />
    <corners android:radius="24dp" />
    <!-- 1px Specular Border -->
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
